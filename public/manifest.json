{
  "manifest_version": 3,
  "name": "SlopBlock for Marketplace",
  "version": "0.4.0",
  "description": "Local filters for Facebook Marketplace spam, dropship listings, bait pricing, store ads, and redirects.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://www.facebook.com/marketplace*",
    "https://facebook.com/marketplace*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace*",
        "https://facebook.com/marketplace*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SlopBlock",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}